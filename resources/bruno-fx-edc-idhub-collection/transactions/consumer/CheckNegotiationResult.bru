meta {
  name: CheckNegotiationResult
  type: http
  seq: 3
}

get {
  url: {{CONSUMER_MANAGEMENT}}/v3/contractnegotiations/{{negotiation-id}}
  body: none
  auth: inherit
}

headers {
  Accept: application/json
  x-api-key: {{CONSUMER_MANAGEMENT_API_KEY}}
}

script:post-response {
  const contractId = res.getBody()['contractAgreementId']; 
  bru.setEnvVar("contractId", contractId);
}

tests {
  test("contains contractAgreementId", function() {
    const contractAgreementId = res.getBody().contractAgreementId;
    expect(contractAgreementId).to.be.a("string");
  })
}

settings {
  encodeUrl: true
  timeout: 0
}
